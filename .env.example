# ============================================================
# CapScribe AI Studio - Environment Configuration
# ============================================================

# Backend Settings
APP_NAME="CapScribe AI"
ENVIRONMENT="development"
PORT=8000
HOST="127.0.0.1"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# AI Transcription Engine
WHISPER_MODEL_SIZE="base"  # options: tiny, base, small, medium, large-v3
WHISPER_DEVICE="cpu"       # options: cpu, cuda
WHISPER_COMPUTE_TYPE="int8" # options: int8, float16, float32

# Storage & Processing Limits
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_MINUTES=30
ALLOWED_EXTENSIONS=".mp4,.mov,.m4v,.webm"

# Optional Cloud Integrations (Defaults to zero-cost local SQLite and disk storage)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Frontend Settings (frontend/.env.local)
NEXT_PUBLIC_APP_NAME="CapScribe AI"
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000"
